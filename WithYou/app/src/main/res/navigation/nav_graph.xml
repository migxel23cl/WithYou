<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="cl.withyou.app.ui.home.HomeFragment"
        android:label="@string/app_name" />

    <!-- Pantallas del asistente: las abre MainActivity según el estado de la conversación -->
    <fragment
        android:id="@+id/confirmFragment"
        android:name="cl.withyou.app.ui.confirm.ConfirmFragment"
        android:label="@string/title_confirm" />

    <fragment
        android:id="@+id/clarifyFragment"
        android:name="cl.withyou.app.ui.clarify.ClarifyFragment"
        android:label="@string/title_clarify" />

    <fragment
        android:id="@+id/resultFragment"
        android:name="cl.withyou.app.ui.result.ResultFragment"
        android:label="@string/title_result" />

    <fragment
        android:id="@+id/messagesFragment"
        android:name="cl.withyou.app.ui.messages.MessagesFragment"
        android:label="@string/title_messages" />

    <fragment
        android:id="@+id/contactsFragment"
        android:name="cl.withyou.app.ui.contacts.ContactsFragment"
        android:label="@string/title_contacts" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="cl.withyou.app.ui.settings.SettingsFragment"
        android:label="@string/title_settings" />

</navigation>

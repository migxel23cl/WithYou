<?xml version="1.0" encoding="utf-8"?>
<!-- "Intentar de nuevo" y "Cancelar" quedan fijos abajo, siempre visibles (como en Confirmar). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <TextView
                android:id="@+id/clarify_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:accessibilityLiveRegion="polite"
                android:textAppearance="@style/TextAppearance.WithYou.Title"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/heard_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.WithYou.Body"
                android:textColor="@color/text_secondary"
                android:visibility="gone" />

            <!-- Hasta 3 opciones numeradas (CU-06) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_1"
                style="@style/Widget.WithYou.OptionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_2"
                style="@style/Widget.WithYou.OptionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/option_3"
                style="@style/Widget.WithYou.OptionButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/mic_button"
                    android:layout_width="@dimen/touch_min"
                    android:layout_height="@dimen/touch_min"
                    android:background="@drawable/bg_mic_button"
                    android:contentDescription="@string/answer_by_voice"
                    android:padding="14dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/mic_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"
                    android:text="@string/answer_by_voice"
                    android:textAppearance="@style/TextAppearance.WithYou.Body" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Botones fijos abajo, lado a lado para dejar más espacio a las opciones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/background"
        android:elevation="8dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/try_again_button"
            style="@style/Widget.WithYou.BigButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/try_again"
            android:textSize="@dimen/text_body"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_refresh"
            app:iconSize="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Widget.WithYou.BigButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/button_cancel"
            android:textSize="@dimen/text_body"
            app:backgroundTint="@color/cancel"
            app:icon="@drawable/ic_close"
            app:iconSize="24dp" />
    </LinearLayout>

</LinearLayout>

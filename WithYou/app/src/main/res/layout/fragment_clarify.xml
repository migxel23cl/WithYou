<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <TextView
            android:id="@+id/clarify_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.WithYou.Title"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/heard_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.WithYou.Body"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <!-- Hasta 3 opciones numeradas (CU-06) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/option_1"
            style="@style/Widget.WithYou.OptionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option_2"
            style="@style/Widget.WithYou.OptionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/option_3"
            style="@style/Widget.WithYou.OptionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/try_again_button"
            style="@style/Widget.WithYou.BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/try_again"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_refresh" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Widget.WithYou.BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing"
            android:text="@string/button_cancel"
            app:backgroundTint="@color/cancel"
            app:icon="@drawable/ic_close" />

        <ImageButton
            android:id="@+id/mic_button"
            android:layout_width="@dimen/small_mic_size"
            android:layout_height="@dimen/small_mic_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_mic_button"
            android:contentDescription="@string/answer_by_voice"
            android:elevation="4dp"
            android:padding="@dimen/small_mic_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/mic_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:text="@string/answer_by_voice"
            android:textAppearance="@style/TextAppearance.WithYou.Body" />

    </LinearLayout>
</ScrollView>

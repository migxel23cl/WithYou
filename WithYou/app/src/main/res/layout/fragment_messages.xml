<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:text="@string/messages_question"
        android:textAppearance="@style/TextAppearance.WithYou.Title" />

    <!-- Sin contactos: se explica y se ofrece ir a Contactos -->
    <LinearLayout
        android:id="@+id/empty_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/messages_no_contacts"
            android:textAppearance="@style/TextAppearance.WithYou.Body"
            android:textColor="@color/text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/go_to_contacts_button"
            style="@style/Widget.WithYou.BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing"
            android:text="@string/go_to_contacts"
            app:backgroundTint="@color/primary"
            app:icon="@drawable/ic_contacts" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recipients_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/screen_padding" />

    <!-- Micrófono grande "Dictar mensaje" -->
    <LinearLayout
        android:id="@+id/dictate_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/spacing">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:paddingBottom="8dp"
            android:textAppearance="@style/TextAppearance.WithYou.Body"
            android:textColor="@color/primary_dark"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/mic_button"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:background="@drawable/bg_mic_button"
            android:contentDescription="@string/dictate_message"
            android:elevation="6dp"
            android:padding="28dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/mic_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:text="@string/dictate_message"
            android:textAppearance="@style/TextAppearance.WithYou.Body"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <!-- Comando detectado -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/screen_padding">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_detected"
                    android:textAppearance="@style/TextAppearance.WithYou.Body"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/confirm_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityHeading="true"
                    android:textAppearance="@style/TextAppearance.WithYou.Title" />

                <TextView
                    android:id="@+id/confirm_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textAppearance="@style/TextAppearance.WithYou.Body"
                    android:textSize="22sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Burbuja del asistente: se muestra y se dice a la vez (RF-13) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing"
            app:cardBackgroundColor="@color/card_accent"
            app:cardCornerRadius="@dimen/card_radius"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/assistant_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:padding="@dimen/spacing"
                android:textAppearance="@style/TextAppearance.WithYou.Body"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/heard_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.WithYou.Body"
            android:textColor="@color/text_secondary"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirm_button"
            style="@style/Widget.WithYou.BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:backgroundTint="@color/confirm"
            app:icon="@drawable/ic_check" />

        <!-- Solo para mensajes: volver a dictar el texto (CU-03) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/redictate_button"
            style="@style/Widget.WithYou.OptionButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing"
            android:gravity="center"
            android:text="@string/redictate_message"
            android:visibility="gone"
            app:icon="@drawable/ic_mic"
            app:iconGravity="textStart"
            app:iconSize="28dp"
            app:iconTint="@color/primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancel_button"
            style="@style/Widget.WithYou.BigButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing"
            android:text="@string/button_cancel"
            app:backgroundTint="@color/cancel"
            app:icon="@drawable/ic_close" />

        <!-- También se puede responder "sí" o "no" por voz (CU-08) -->
        <ImageButton
            android:id="@+id/mic_button"
            android:layout_width="@dimen/small_mic_size"
            android:layout_height="@dimen/small_mic_size"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_mic_button"
            android:contentDescription="@string/answer_by_voice"
            android:elevation="4dp"
            android:padding="@dimen/small_mic_icon_padding"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/mic_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:importantForAccessibility="no"
            android:text="@string/answer_by_voice"
            android:textAppearance="@style/TextAppearance.WithYou.Body" />

    </LinearLayout>
</ScrollView>

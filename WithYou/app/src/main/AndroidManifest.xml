<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Los permisos se agregan solo cuando una funcionalidad los necesita (RNF-06). -->
    <!-- Micrófono: para escuchar las instrucciones habladas (RF-01). Se pide en tiempo de ejecución. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Alarmas: permiso normal (no se pide al usuario) para crearlas en el reloj del sistema (RF-05). -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Llamadas: para llamar directo tras la confirmación del usuario (RF-06). Se pide en tiempo de
         ejecución; si se niega, se abre el teléfono con el número marcado (ACTION_DIAL). -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- CALL_PHONE no obliga a que el equipo tenga telefonía: la app también se instala en tablets. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- Android 11+: sin esto, el reconocedor de voz y el motor de TTS aparecen como no disponibles. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="smsto" />
        </intent>
    </queries>

    <application
        android:name=".WithYouApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WithYou">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
